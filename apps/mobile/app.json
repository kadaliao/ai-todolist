{
  "expo": {
    "name": "Docket",
    "slug": "docket",
    "version": "0.1.0",
    "scheme": "docket",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.docket.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Docket uses the microphone when you dictate tasks.",
        "NSSpeechRecognitionUsageDescription": "Docket turns your dictation into tasks."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.docket.mobile"]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "app.docket.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F8F6A",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FBFBFC",
          "dark": {
            "backgroundColor": "#17191E"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#1F8F6A"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
