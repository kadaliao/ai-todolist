<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets macOS show its own menu items (Emoji & Symbols, Start Dictation, window tiling) in Chinese too. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- The assistant listens when you hold the mic or Space (WKWebView getUserMedia / speech recognition). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Docket 在你按住麦克风时听你说要做的事。Docket listens while you hold the mic, to hear what you want done.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Docket 把你说的话转成文字，交给助手处理。Docket turns what you say into text for the assistant.</string>
</dict>
</plist>
