{
  "name": "@ai-todo/server",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "build": "esbuild src/main.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --sourcemap --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude test/ai.live.test.ts",
    "eval": "vitest run test/ai.live.test.ts --silent=false"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@ai-todo/core": "workspace:^",
    "@hono/node-server": "^2.1.8",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.172",
    "hono": "^4.13.18",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
