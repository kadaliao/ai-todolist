# Time zone for "today" in MCP tools
DOCKET_TZ=Asia/Shanghai
# Any OpenAI-compatible endpoint (aihubmix, OpenRouter, DeepSeek, Ollama…). Leave empty to disable AI.
DOCKET_AI_BASE_URL=https://api.deepseek.com/v1
DOCKET_AI_API_KEY=
DOCKET_AI_MODEL=deepseek-chat
# 0 for providers without json_schema structured outputs (e.g. DeepSeek)
DOCKET_AI_STRUCTURED_OUTPUTS=0
# Optional cloud speech recognition for the voice assistant (devices use the system recognizer
# by default). Any OpenAI-compatible /audio/transcriptions endpoint; base URL and key default to
# the DOCKET_AI_* ones. Examples: SiliconFlow + FunAudioLLM/SenseVoiceSmall, OpenAI or aihubmix +
# gpt-4o-mini-transcribe / whisper-1.
DOCKET_STT_MODEL=
DOCKET_STT_BASE_URL=
DOCKET_STT_API_KEY=
